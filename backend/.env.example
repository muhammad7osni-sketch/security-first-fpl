# PHASE 4 Backend Configuration
# Copy to .env for local development

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# OAuth 2.0 OIDC (PingOne)
OIDC_CLIENT_ID=your-pingone-client-id-here
OIDC_AUTHORITY=https://account.premierleague.com/as
OIDC_JWKS_URI=https://account.premierleague.com/as/jwks
OIDC_TOKEN_ENDPOINT=https://account.premierleague.com/as/token

# FPL API
FPL_API_BASE_URL=https://fantasy.premierleague.com/api

# Supabase
SUPABASE_URL=your-supabase-url-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Encryption
ENCRYPTION_KEY_CURRENT=base64-encoded-256-bit-key

# GCP
GCP_PROJECT_ID=your-gcp-project-id

# Sentry
SENTRY_DSN=https://your-sentry-dsn-here
